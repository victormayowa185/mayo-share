{
  "name": "mayo-share",
  "version": "1.0.0",
  "description": "Offline P2P File Sharing",
  "author": "Victor Mayowa",
  "main": "dist/backend/index.js",
  "scripts": {
    "copy:locales": "xcopy /E /I /Y src\\locales dist\\locales",
    "copy:logo": "copy /Y src\\frontend\\src\\assets\\mayo.png dist\\backend\\mayo.png",
    "copy:icon": "copy /Y src\\frontend\\src\\assets\\mayo.ico dist\\backend\\mayo.ico",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build",
    "build": "npm run build:backend && npm run copy:locales && npm run copy:logo  && npm run copy:icon && npm run build:preload && npm run build:frontend",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dev": "concurrently -k -n VITE,BACKEND,PRELOAD,ELECTRON -c cyan,yellow,magenta,green \"npm:dev:vite\" \"npm:dev:backend\" \"npm:dev:preload\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:backend": "tsc -p tsconfig.backend.json -w --preserveWatchOutput",
    "dev:preload": "tsc -p tsconfig.preload.json -w --preserveWatchOutput",
    "dev:electron": "wait-on http://localhost:5173 dist/backend/index.js dist/preload/index.js && npm run copy:locales && npm run copy:logo && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electronmon ."
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.mayo.share",
    "productName": "MAYO Share",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/frontend/src/assets/mayo.ico",
      "asar": false,
      "signtoolOptions": {
        "sign": null
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.5.1",
    "@types/node": "^20.19.41",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "typescript": "^5.4.0",
    "vite": "^8.0.11",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@solana/web3.js": "^1.98.4",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "bs58": "^6.0.0",
    "firebase": "^12.14.0",
    "formidable": "^3.5.4",
    "gsap": "^3.15.0",
    "i18next": "^26.2.0",
    "i18next-electron-fs-backend": "^4.0.0",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "multicast-dns": "^7.2.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "resumablejs": "^1.1.0",
    "selfsigned": "^2.4.1",
    "sudo-prompt": "^9.2.1",
    "tweetnacl": "^1.0.3"
  }
}
